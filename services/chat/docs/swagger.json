{
    "swagger": "2.0",
    "info": {
        "description": "API server for chat service",
        "title": "HLT chat service API",
        "contact": {},
        "version": "1.0"
    },
    "host": "localhost:8080",
    "basePath": "/api/v1",
    "paths": {
        "/api/chat/messages": {
            "get": {
                "security": [
                    {
                        "UserIdAuth": []
                    }
                ],
                "description": "Возвращает список сообщений чата с фильтрацией по sequence",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "messages"
                ],
                "summary": "Получить историю сообщений",
                "parameters": [
                    {
                        "type": "string",
                        "description": "ID чата",
                        "name": "chat_id",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "integer",
                        "description": "Sequence сообщения, после которого нужно получить новые",
                        "name": "after_sequence",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "description": "Лимит сообщений (по умолчанию 50)",
                        "name": "limit",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/dto.MessageResponse"
                            }
                        }
                    },
                    "400": {
                        "description": "missing chat_id or invalid parameters",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "403": {
                        "description": "is not member of chat",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "500": {
                        "description": "internal server error",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/api/chat/read": {
            "post": {
                "security": [
                    {
                        "UserIdAuth": []
                    }
                ],
                "description": "Обновляет статус прочитанных сообщений (last_read_sequence) для текущего пользователя",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "chats"
                ],
                "summary": "Прочитать сообщения",
                "parameters": [
                    {
                        "description": "Данные для отметки о прочтении",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/dto.MarkReadRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "400": {
                        "description": "invalid request body or missing parameters",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "403": {
                        "description": "is not member of chat",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "500": {
                        "description": "internal server error",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/api/chats": {
            "get": {
                "security": [
                    {
                        "UserIdAuth": []
                    }
                ],
                "description": "Возвращает пагинированный список чатов текущего пользователя",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "chats"
                ],
                "summary": "Получить список чатов",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "Лимит чатов (от 1 до 50, по умолчанию 20)",
                        "name": "limit",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Курсор для пагинации",
                        "name": "cursor",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/dto.PaginatedChatsResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            },
            "post": {
                "security": [
                    {
                        "UserIdAuth": []
                    }
                ],
                "description": "Создает новый direct-чат с пользователем или возвращает существующий",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "chats"
                ],
                "summary": "Создать чат",
                "parameters": [
                    {
                        "description": "ID партнера",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/dto.CreateChatRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Чат уже существует",
                        "schema": {
                            "$ref": "#/definitions/dto.ChatSummaryResponse"
                        }
                    },
                    "201": {
                        "description": "Чат создан",
                        "schema": {
                            "$ref": "#/definitions/dto.ChatSummaryResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "502": {
                        "description": "Bad Gateway",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/api/messages": {
            "post": {
                "security": [
                    {
                        "UserIdAuth": []
                    }
                ],
                "description": "Отправляет новое сообщение в указанный чат",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "messages"
                ],
                "summary": "Отправить сообщение",
                "parameters": [
                    {
                        "description": "Данные сообщения",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/dto.PostMessageRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Сообщение уже существует",
                        "schema": {
                            "$ref": "#/definitions/dto.MessageResponse"
                        }
                    },
                    "201": {
                        "description": "Created",
                        "schema": {
                            "$ref": "#/definitions/dto.MessageResponse"
                        }
                    },
                    "400": {
                        "description": "Invalid JSON",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "409": {
                        "description": "Conflict",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "dto.ChatSummaryResponse": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "string"
                },
                "last_message": {
                    "$ref": "#/definitions/dto.MessageResponse"
                },
                "revision": {
                    "type": "integer"
                },
                "unread_count": {
                    "type": "integer"
                },
                "updated_at": {
                    "type": "string"
                }
            }
        },
        "dto.CreateChatRequest": {
            "type": "object",
            "properties": {
                "partner_id": {
                    "type": "string"
                }
            }
        },
        "dto.MarkReadRequest": {
            "type": "object",
            "properties": {
                "chat_id": {
                    "type": "string"
                },
                "last_read_sequence": {
                    "type": "integer"
                }
            }
        },
        "dto.MessageResponse": {
            "type": "object",
            "properties": {
                "chat_id": {
                    "type": "string"
                },
                "client_message_id": {
                    "type": "string"
                },
                "content": {
                    "type": "string"
                },
                "created_at": {
                    "type": "string"
                },
                "id": {
                    "type": "string"
                },
                "sender_id": {
                    "type": "string"
                },
                "sequence": {
                    "type": "integer"
                }
            }
        },
        "dto.PaginatedChatsResponse": {
            "type": "object",
            "properties": {
                "items": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/dto.ChatSummaryResponse"
                    }
                },
                "next_cursor": {
                    "type": "string"
                }
            }
        },
        "dto.PostMessageRequest": {
            "type": "object",
            "properties": {
                "chat_id": {
                    "type": "string"
                },
                "client_message_id": {
                    "type": "string"
                },
                "text": {
                    "type": "string"
                }
            }
        }
    },
    "securityDefinitions": {
        "UserIdAuth": {
            "type": "apiKey",
            "name": "X-User-Id",
            "in": "header"
        }
    }
}